from PIL import Image

img_path = 'your_image.png' 
img = Image.open(img_path).convert('L').resize((64, 64))

width, height = img.size
complex_points = []

# Map pixel coordinates to IQ plane (-1 to +1)
for y in range(height):
    for x in range(width):
        pixel_value = img.getpixel((x, y))
        # Assuming dark drawing on a light background (threshold < 128)
        if pixel_value < 128:
            i = (x / (width - 1)) * 2.0 - 1.0
            q = -((y / (height - 1)) * 2.0 - 1.0)  # Invert Y for Cartesian plot
            complex_points.append(complex(i, q))

# Print the copy-pasteable vector
print("Generated Vector for GNU Radio:")
print(repr(complex_points))
